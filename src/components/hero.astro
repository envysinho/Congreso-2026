---
import heroPerson from "../assets/images/png-persona.png";
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-left"></div>

        <div class="hero-right" aria-label="Contenido destacado">
            <img
                class="hero-person-image"
                src={heroPerson.src}
                width={heroPerson.width}
                height={heroPerson.height}
                alt="Profesional de ingeniería destacado"
            />
            <div class="hero-person-info">
                <p class="hero-person-name">Jhon Smith</p>
                <p class="hero-person-role">Ingeniero de Sistemas</p>
            </div>
        </div>
    </div>
</section>
