    },
    {
        player: "Player 4",
        name: "Diego Vergara",
        company: "Univ. Católica de Ávila",
        image: heroPerson,
        alt: "Participante destacado: Diego Vergara",
    },
    {
        player: "Player 5",
        name: "José Verbel",
