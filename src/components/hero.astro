const logos = [
    { name: "Huawei", src: "/images/logos/huawei.svg" },
    { name: "Universidad Tecnológica Nacional", src: "/images/logos/utn.png" },
    { name: "CENTRUM PUCP", src: "/images/logos/centrum-pucp.svg" },
    { name: "Universidad Católica de Ávila", src: "/images/logos/ucavila.png" },
    { name: "Solati SAS", src: "/images/logos/solati.png" },
    { name: "Google Developers", src: "/images/logos/google-developers.svg" },
    { name: "Universidad Nacional Mayor de San Marcos", src: "/images/logos/unmsm.svg" },
    { name: "Universidad de Lima", src: "/images/logos/ulima.svg" },
    { name: "Universidad Peruana Los Andes", src: "/images/logos/upla.png" },
    { name: "Universidad Continental", src: "/images/logos/continental.svg" },
    { name: "Cisco", src: "/images/logos/cisco.svg" },
];
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-left">
            <div class="hero-intro">
                <p class="hero-kicker">
                    <span class="hero-kicker-status" aria-hidden="true"></span>
                    CIISIC · VIII EDICIÓN
                </p>

                <h1 class="hero-title">
                    El futuro no se espera.
                    <span>Se diseña.</span>
                </h1>

                <p class="hero-event-name">
                    Congreso Internacional de Ingeniería de Sistemas e Investigación Científica
                </p>

                <p class="hero-summary">
                    Un encuentro para convertir investigación, tecnología e innovación en soluciones con impacto real.
                </p>

                <div class="hero-actions" aria-label="Acciones principales">
                    <a class="hero-cta hero-cta-primary" href="#informacion">
                        Quiero participar
                        <span aria-hidden="true">↗</span>
                    </a>
                    <a class="hero-cta hero-cta-secondary" href="#ponentes">Explorar ponentes</a>
                </div>

                <dl class="hero-meta" aria-label="Datos del evento">
                    <div class="hero-meta-item">
                        <dt>Fecha</dt>
                        <dd>Próximamente</dd>
                    </div>
                    <div class="hero-meta-item">
                        <dt>Sede</dt>
                        <dd>Por confirmar</dd>
                    </div>
                </dl>

                <p class="hero-update-status">
                    <span aria-hidden="true"></span>
                    Información oficial en preparación
                </p>
            </div>
        </div>

        <div id="ponentes" class="hero-right" data-hero-people-slider aria-label="Contenido destacado" tabindex="0">
            <div class="hero-person-slides">
                {
                    people.map((person, index) => (
                        <article
                            class={`hero-person-slide${index === 0 ? " is-active" : index === 1 ? " is-next" : index === people.length - 1 ? " is-prev" : ""}`}
                            data-hero-person-slide
                            aria-hidden={index === 0 ? "false" : "true"}
                        >
                            <div class="hero-person-marker" aria-hidden="true">
                                <p class="hero-person-marker-label">{person.player}</p>
                            </div>
                            <img
                                class="hero-person-image"
                                src={person.image.src}
                                width={person.image.width}
                                height={person.image.height}
                                alt={person.alt}
                            />
                            <div class="hero-person-info">
                                <p class="hero-person-name">{person.name}</p>
                                <p class="hero-person-company">{person.company}</p>
                            </div>
                        </article>
                    ))
                }
            </div>

            <div class="hero-slider-dots" aria-label="Seleccionar persona destacada">
                {
                    people.map((person, index) => (
                        <button
                            class={`hero-slider-dot${index === 0 ? " is-active" : ""}`}
                            data-hero-slider-dot
                            data-hero-slider-index={index}
                            type="button"
                            aria-label={`Mostrar a ${person.name}`}
                            aria-current={index === 0 ? "true" : "false"}
                        />
                    ))
                }
            </div>
        </div>

        <div class="hero-bottom" aria-label="Logos de participantes">
            <div class="hero-logo-marquee">
                <div class="hero-logo-track">
                    {[...logos, ...logos].map((logo, index) => (
                        <div class="hero-logo-item" aria-hidden={index >= logos.length ? "true" : undefined}>
                            <img
                                class="hero-logo-image"
                                src={logo.src}
                                alt={index < logos.length ? logo.name : ""}
                                width="160"
                                height="40"
                                loading="eager"
                                draggable="false"
                            />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>
