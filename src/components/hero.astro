        alt: "Profesional de ingeniería destacado: Lucia Navarro",
    },
];
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-left"></div>

        <div class="hero-right" data-hero-people-slider aria-label="Contenido destacado">
            <button class="hero-slider-button hero-slider-button-prev" data-hero-slider-prev type="button" aria-label="Persona anterior">
                &lsaquo;
            </button>

            <div class="hero-person-slides">
                {
                    people.map((person, index) => (
                        <article
                            class={`hero-person-slide${index === 0 ? " is-active" : index === 1 ? " is-next" : index === people.length - 1 ? " is-prev" : ""}`}
                            data-hero-person-slide
                            aria-hidden={index === 0 ? "false" : "true"}
                        >
                            <img
                                class="hero-person-image"
                                src={person.image.src}
                                width={person.image.width}
                                height={person.image.height}
                                alt={person.alt}
                            />
                            <div class="hero-person-info">
                                <p class="hero-person-name">{person.name}</p>
                                <p class="hero-person-role">{person.role}</p>
                            </div>
                        </article>
                    ))
                }
            </div>

            <button class="hero-slider-button hero-slider-button-next" data-hero-slider-next type="button" aria-label="Persona siguiente">
                &rsaquo;
            </button>
        </div>
    </div>
</section>
