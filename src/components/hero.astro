        name: "Jim Dios",
        company: "Universidad de Lima",
        image: heroPerson,
        alt: "Participante destacado: Jim Dios",
    },
    {
        player: "Player 10",
        name: "Jowel Cabrera",
        company: "Univ. Peruana Los Andes",
        image: heroPerson,
        alt: "Participante destacado: Jowel Cabrera",
    },
    {
        player: "Player 11",
        name: "Ivo Yance",
        company: "Universidad Continental",
        image: heroPerson,
        alt: "Participante destacado: Ivo Yance",
    },
