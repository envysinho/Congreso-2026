---
import heroPerson from "../assets/images/png-persona.png";

const people = [
    {
        player: "Player 1",
        name: "Nadim Alvarez",
        company: "Huawei Peru",
        image: heroPerson,
        alt: "Participante destacado: Nadim Alvarez",
    },
    {
        player: "Player 2",
        name: "Abigail Kauf",
        company: "UTN Argentina",
        image: heroPerson,
        alt: "Participante destacado: Abigail Kauf",
    },
    {
        player: "Player 3",
        name: "Gera Flores",
        company: "CENTRUM PUCP",
        image: heroPerson,
        alt: "Participante destacado: Gera Flores",
    },
    {
        player: "Player 4",
        name: "Diego Vergara",
        company: "Univ. Católica de Ávila",
        image: heroPerson,
        alt: "Participante destacado: Diego Vergara",
    },
    {
        player: "Player 5",
        name: "José Verbel",
        company: "Salati SAS",
        image: heroPerson,
        alt: "Participante destacado: José Verbel",
    },
    {
        player: "Player 6",
        name: "Pablo Fernández",
        company: "Univ. Católica de Ávila",
        image: heroPerson,
        alt: "Participante destacado: Pablo Fernández",
    },
    {
        player: "Player 7",
        name: "Damián Siré",
        company: "Google GDE",
        image: heroPerson,
        alt: "Participante destacado: Damián Siré",
    },
    {
        player: "Player 8",
        name: "Ciro Rodríguez",
        company: "UNMSM",
        image: heroPerson,
        alt: "Participante destacado: Ciro Rodríguez",
    },
    {
        player: "Player 9",
        name: "Jim Dios",
        company: "Universidad de Lima",
        image: heroPerson,
        alt: "Participante destacado: Jim Dios",
    },
    {
        player: "Player 10",
        name: "Jowel Cabrera",
        company: "Univ. Peruana Los Andes",
        image: heroPerson,
        alt: "Participante destacado: Jowel Cabrera",
    },
    {
        player: "Player 11",
        name: "Ivo Yance",
        company: "Universidad Continental",
        image: heroPerson,
        alt: "Participante destacado: Ivo Yance",
    },
    {
        player: "Player 12",
        name: "Miguel Garro",
        company: "Cisco Systems",
        image: heroPerson,
        alt: "Participante destacado: Miguel Garro",
    },
];

const logos = Array.from({ length: 10 }, (_, index) => `Logo ${index + 1}`);
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-left"></div>

        <div class="hero-right" data-hero-people-slider aria-label="Contenido destacado" tabindex="0">
            <div class="hero-person-slides">
                {
                    people.map((person, index) => (
                        <article
                            class={`hero-person-slide${index === 0 ? " is-active" : index === 1 ? " is-next" : index === people.length - 1 ? " is-prev" : ""}`}
                            data-hero-person-slide
                            aria-hidden={index === 0 ? "false" : "true"}
                        >
                            <div class="hero-person-marker" aria-hidden="true">
                                <p class="hero-person-marker-label">{person.player}</p>
                            </div>
                            <img
                                class="hero-person-image"
                                src={person.image.src}
                                width={person.image.width}
                                height={person.image.height}
                                alt={person.alt}
                            />
                            <div class="hero-person-info">
                                <p class="hero-person-name">{person.name}</p>
                                <p class="hero-person-company">{person.company}</p>
                            </div>
                        </article>
                    ))
                }
            </div>

            <div class="hero-slider-dots" aria-label="Seleccionar persona destacada">
                {
                    people.map((person, index) => (
                        <button
                            class={`hero-slider-dot${index === 0 ? " is-active" : ""}`}
                            data-hero-slider-dot
                            data-hero-slider-index={index}
                            type="button"
                            aria-label={`Mostrar a ${person.name}`}
                            aria-current={index === 0 ? "true" : "false"}
                        />
                    ))
                }
            </div>
        </div>

        <div class="hero-bottom" aria-label="Logos de participantes">
            <div class="hero-logo-marquee">
                <div class="hero-logo-track">
                    {[...logos, ...logos].map((logo) => (
                        <div class="hero-logo-item" aria-hidden="true">{logo}</div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>
