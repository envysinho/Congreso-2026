        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Maria Torres",
    },
    {
        name: "Carlos Rivera",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Carlos Rivera",
    },
    {
        name: "Ana Mendoza",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Ana Mendoza",
    },
    {
        name: "Luis Herrera",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Luis Herrera",
    },
    {
        name: "Sofia Ramirez",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Sofia Ramirez",
    },
    {
        name: "Diego Castillo",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Diego Castillo",
    },
    {
        name: "Valeria Flores",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Valeria Flores",
    },
    {
        name: "Mateo Vargas",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Mateo Vargas",
    },
    {
        name: "Camila Rojas",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Camila Rojas",
    },
    {
        name: "Andres Silva",
        role: "Ingeniero de Sistemas",
        image: heroPerson,
        alt: "Profesional de ingeniería destacado: Andres Silva",
    },
