---
import ciisicSymbol from "../assets/images/ciisic-symbol.png";
import "../styles/navbar.css";
---

<nav class="navbar">
    <a class="logo" href="/" aria-label="Ir al inicio">
        <img
            class="navbar-logo"
            src={ciisicSymbol.src}
            width={ciisicSymbol.width}
            height={ciisicSymbol.height}
            alt=""
            loading="eager"
            decoding="async"
        />
        <span class="navbar-wordmark">VIII CIISIC</span>
    </a>

    <div class="nav-links">
        <label class="nav-combobox">
            <span class="sr-only">Primera opcion</span>
            <select aria-label="Primera opcion">
                <option>option</option>
                <option>Option 1</option>
                <option>Option 2</option>
            </select>
        </label>

        <label class="nav-combobox">
            <span class="sr-only">Segunda opcion</span>
            <select aria-label="Segunda opcion">
                <option>option</option>
                <option>Option 1</option>
                <option>Option 2</option>
            </select>
        </label>

        <label class="nav-combobox">
            <span class="sr-only">Tercera opcion</span>
            <select aria-label="Tercera opcion">
                <option>option</option>
                <option>Option 1</option>
                <option>Option 2</option>
            </select>
        </label>
    </div>

    <a class="register-button" href="#">Registro</a>
</nav>
